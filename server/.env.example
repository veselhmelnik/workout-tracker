# Setline API configuration. Copy to server/.env; .env is gitignored.
# Names only — never commit real values.

# PostgreSQL connection string.
DATABASE_URL=

# Secret used to sign access tokens. Use a long random string
# (e.g. `openssl rand -base64 48`) and rotate it out of band.
JWT_SECRET=

# Comma-separated OAuth client ids accepted as the Google ID token audience.
# Android issues the token with the WEB client id as its audience, so this is
# the web client id, not the Android one. Include every variant's client.
GOOGLE_CLIENT_IDS=

# Optional. Defaults to 3000.
PORT=
