# Local build configuration. Copy to .env and fill in; .env is gitignored,
# so EAS builds take these from the build profile in eas.json instead.

# Which app identity a local build produces: "development" or "production".
#   development -> Setline Dev, com.hmelnik.workouttracker.dev, scheme setline-dev
#   production  -> Setline,     com.hmelnik.workouttracker,     scheme setline
# Anything else, including unset, resolves to production. Keep this on
# "development" locally so `expo run:android` cannot overwrite the real app.
# Separate from the billing mode below — app identity and billing backend are
# independent settings and neither is derived from the other.
APP_VARIANT=development

# Setline API base URL, e.g. https://api.example.com (no trailing slash).
# On an Android device `localhost` is the phone, not your computer, so a local
# backend needs your machine's LAN IP (http://192.168.x.x:3000), a tunnel, or
# a deployed dev backend. Unset means accounts report unavailable; local
# workout tracking is unaffected.
EXPO_PUBLIC_API_BASE_URL=

# Google OAuth WEB client id — not the Android client id. Android issues the
# ID token with the web client as its audience. Must match the server's
# GOOGLE_CLIENT_IDS or every sign-in is rejected. Public, not a secret.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat SDK keys.
#
# Only PUBLIC RevenueCat SDK keys belong here. EXPO_PUBLIC_ variables are
# inlined into the JavaScript bundle and are readable by anyone with the app,
# so a RevenueCat secret key, a Google service-account credential or an App
# Store Connect private key must never be set this way.

# Which RevenueCat project this build talks to: "test" or "production".
# Anything else disables billing. EAS sets this per profile in eas.json
# (development and preview are "test", production is "production"); this local
# value is what `npm start` and a local export use.
EXPO_PUBLIC_REVENUECAT_MODE=test

# Test Store. Used only when the mode above is "test".
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# Production keys, one per platform. Used only when the mode is "production".
# Not required yet — with these unset a production build reports billing
# unavailable and the app stays Free. It never falls back to the Test Store
# key, which is not read on the production path at all.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
